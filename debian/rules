#!/usr/bin/make -f
%:
	dh $@

# skip "make clean" to avoid dependency on fut
override_dh_auto_clean:

override_dh_auto_build:
	$(MAKE) CFLAGS="$(CFLAGS)" recoil2png file-recoil$(shell pkg-config --exists gimp-3.0 && echo 3) Xrecoil.usr

override_dh_auto_install:
	$(MAKE) PREFIX=$$(pwd)/debian/tmp/usr libdir=$$(pwd)/debian/tmp/usr/lib XNVIEW=$$(pwd)/debian/tmp/opt/XnView BUILDING_PACKAGE=1 install-gimp$(shell pkg-config --exists gimp-3.0 && echo 3 || echo 2) install-thumbnailer install-xnview
